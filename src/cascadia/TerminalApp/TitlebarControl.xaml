<Grid x:Class="TerminalApp.TitlebarControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:TerminalApp"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      x:Name="Root"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Top"
      MinHeight="{ThemeResource WinTermTitlebarHeight}"
      Background="{ThemeResource WinTermTitlebarBrush}"
      d:DesignHeight="36"
      d:DesignWidth="400"
      SizeChanged="Root_SizeChanged"
      mc:Ignorable="d">

    <!--
        TODO:GH#1988
        This xaml should probably be a template thing, where the background is a
        resource that the app hosting this control can override. Then, it App.xaml,
        we'd make sure to set the resource for our background to the appropriate
        color. SystemControlForegroundAccentBrush also works nicely, to use the
        accent color. (which is GH#1963)
    -->

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Border x:Name="WinTermTitlebarSurface"
            Grid.ColumnSpan="4"
            Background="{ThemeResource WinTermTitlebarGradientBrush}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

    <Grid x:Name="WinTermBrandRoot"
          Grid.Column="0"
          MinWidth="0"
          Margin="10,0,8,0"
          VerticalAlignment="Center"
          IsHitTestVisible="False"
          Visibility="Collapsed">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image x:Name="WinTermAppIcon"
               Width="{ThemeResource WinTermTitlebarIconSize}"
               Height="{ThemeResource WinTermTitlebarIconSize}"
               VerticalAlignment="Center"
               Stretch="Uniform" />
        <TextBlock Grid.Column="1"
                   Margin="7,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource WinTermTextBrush}"
                   Text="winTerm" />
    </Grid>

    <ContentPresenter x:Name="ContentRoot"
                      Grid.Column="1" />

    <Border x:Name="DragBar"
            Grid.Column="2"
            MinWidth="45.0"
            DoubleTapped="DragBar_DoubleTapped">
        <TextBlock x:Name="WindowTitle"
                   Margin="12,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{ThemeResource WinTermMutedTextBrush}"
                   IsHitTestVisible="False"
                   TextTrimming="CharacterEllipsis"
                   Visibility="Collapsed" />
    </Border>

    <local:MinMaxCloseControl x:Name="MinMaxCloseControl"
                              Grid.Column="3"
                              HorizontalAlignment="Right" />

    <!--  This border needs to be added manually until GH#10320 is fixed  -->
    <Border Grid.ColumnSpan="4"
            Height="1"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Background="{ThemeResource WinTermTitlebarBorderBrush}" />
</Grid>

